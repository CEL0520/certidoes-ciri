{
  "manifest_version": 3,
  "name": "Certidões CIRI",
  "version": "0.9.3",
  "description": "Gera certidões de citação e intimação a partir dos prints de conversas de WhatsApp e e-mail. Funciona só neste computador.",
  "default_locale": "pt_BR",
  "icons": {
    "16": "icones/16.png",
    "32": "icones/32.png",
    "48": "icones/48.png",
    "128": "icones/128.png"
  },
  "action": {
    "default_title": "Certidões CIRI",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/16.png",
      "32": "icones/32.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "certidoes-ciri@local",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "fundo.js"
  }
}